<view class="page history-page theme-{{theme}}">
  <view class="tabs">
    <view class="tab {{tab === 'history' ? 'is-on' : ''}}" data-tab="history" bindtap="switchTab">
      历史 {{counts.history}}
    </view>
    <view class="tab {{tab === 'fav' ? 'is-on' : ''}}" data-tab="fav" bindtap="switchTab">
      收藏 {{counts.fav}}
    </view>
    <view class="tab {{tab === 'black' ? 'is-on' : ''}}" data-tab="black" bindtap="switchTab">
      黑名单 {{counts.black}}
    </view>
  </view>

  <view class="summary" wx:if="{{tab === 'history'}}">
    <view class="sum-item">
      <view class="sum-num">{{stats.weekCount}}</view>
      <view class="sum-label">本周决定</view>
    </view>
    <view class="sum-item">
      <view class="sum-num sum-text">{{stats.topDish || '—'}}</view>
      <view class="sum-label">本周最爱</view>
    </view>
    <view class="sum-item">
      <view class="sum-num sum-text">{{stats.topCat || '—'}}</view>
      <view class="sum-label">最常分类</view>
    </view>
  </view>

  <view class="week" wx:if="{{tab === 'history'}}">
    <view class="week-title">本周吃了啥</view>
    <view class="week-row">
      <view class="day {{item.isToday ? 'is-today' : ''}} {{item.id ? 'has' : ''}}"
            wx:for="{{calendar}}" wx:key="label"
            data-id="{{item.id}}" bindtap="openDay">
        <view class="day-label">{{item.label}}</view>
        <view class="day-name">{{item.name || item.date}}</view>
      </view>
    </view>
  </view>

  <view class="fav-roll" wx:if="{{tab === 'fav' && list.length}}" bindtap="rollInFav">
    <text>只在收藏里随机</text>
  </view>

  <!-- 历史：按「有没有选它」分成两组，已选择的置顶 -->
  <block wx:if="{{tab === 'history'}}">
    <view class="group" wx:if="{{chosenList.length}}">
      <view class="group-head">
        <view class="group-title">已选择</view>
        <view class="group-count">{{chosenList.length}}</view>
      </view>
      <view class="list">
        <block wx:for="{{chosenList}}" wx:key="id">
          <template is="dishItem" data="{{item: item, tab: tab}}" />
        </block>
      </view>
    </view>

    <view class="group" wx:if="{{otherList.length}}">
      <view class="group-head">
        <view class="group-title">抽过没选</view>
        <view class="group-count">{{otherList.length}}</view>
      </view>
      <view class="list">
        <block wx:for="{{otherList}}" wx:key="id">
          <template is="dishItem" data="{{item: item, tab: tab}}" />
        </block>
      </view>
    </view>

    <view class="empty" wx:if="{{!chosenList.length && !otherList.length}}">
      <view class="empty-art">
        <view class="empty-steam s1"></view>
        <view class="empty-steam s2"></view>
        <view class="empty-steam s3"></view>
        <view class="empty-bowl"></view>
        <view class="empty-base"></view>
      </view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-desc">{{emptyDesc}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="list" wx:if="{{list.length}}">
      <block wx:for="{{list}}" wx:key="id">
        <template is="dishItem" data="{{item: item, tab: tab}}" />
      </block>
    </view>

    <view class="empty" wx:else>
      <view class="empty-art">
        <view class="empty-steam s1"></view>
        <view class="empty-steam s2"></view>
        <view class="empty-steam s3"></view>
        <view class="empty-bowl"></view>
        <view class="empty-base"></view>
      </view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-desc">{{emptyDesc}}</view>
    </view>
  </block>

  <view class="clear-wrap" wx:if="{{tab === 'history' && list.length}}">
    <view class="clear-btn" bindtap="clearHistory">清空历史记录</view>
    <view class="clear-tip">最多保留最近 {{maxHistory}} 条，收藏与黑名单不受影响</view>
  </view>
</view>

<template name="dishItem">
  <view class="item">
    <view class="item-main" data-id="{{item.id}}" bindtap="openDish" hover-class="item-hover">
      <view class="item-name">{{item.name}}</view>

      <view class="item-meta" wx:if="{{tab === 'history'}}">
        <text class="item-cat">{{item.category}}</text>
        <text class="item-time">{{item.timeText}}</text>
        <text class="badge" wx:if="{{item.decided}}">已决定</text>
        <text class="badge badge-manual" wx:if="{{item.sourceText}}">{{item.sourceText}}</text>
      </view>

      <!-- 打卡评分：历史记录里随手补评，喂给口味画像。
           图标与右侧 like/unlike 同规矩：未选 = 深棕线稿，已选 = 各自语义色（橙 / 棕 / 砖红）；
           用矢量 face 图标代替原来的 😋😐😣 emoji（emoji 的 3D 质感就是"AI 味"来源）。 -->
      <view class="item-rate" wx:if="{{tab === 'history'}}">
        <text class="item-rate-label">打卡</text>
        <view class="item-rate-opt {{item.rating === 'good' ? 'is-on' : ''}}"
              data-id="{{item.id}}" data-r="good" catchtap="rateItem">
          <image class="item-rate-ico" mode="aspectFit"
                 src="/assets/history/rate-good{{item.rating === 'good' ? '-on' : ''}}.png" />
        </view>
        <view class="item-rate-opt {{item.rating === 'ok' ? 'is-on' : ''}}"
              data-id="{{item.id}}" data-r="ok" catchtap="rateItem">
          <image class="item-rate-ico" mode="aspectFit"
                 src="/assets/history/rate-ok{{item.rating === 'ok' ? '-on' : ''}}.png" />
        </view>
        <view class="item-rate-opt {{item.rating === 'bad' ? 'is-on' : ''}}"
              data-id="{{item.id}}" data-r="bad" catchtap="rateItem">
          <image class="item-rate-ico" mode="aspectFit"
                 src="/assets/history/rate-bad{{item.rating === 'bad' ? '-on' : ''}}.png" />
        </view>
      </view>

      <view class="item-meta" wx:else>
        <text class="item-cat">{{item.category}}</text>
        <text class="item-time">参考价 ¥{{item.price}}</text>
      </view>

      <view class="item-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
    </view>

    <view class="item-actions like-unlike">
      <view wx:if="{{tab !== 'black'}}"
            class="act {{item.inFav ? 'is-on' : ''}}"
            data-id="{{item.id}}" catchtap="toggleFav">
        <image class="act-icon" src="{{item.inFav ? '/assets/history/like-on.png' : '/assets/history/like.png'}}" mode="aspectFit" />
      </view>
      <view wx:if="{{tab !== 'fav'}}"
            class="act act-black {{item.inBlack ? 'is-on' : ''}}"
            data-id="{{item.id}}" catchtap="toggleBlack">
        <image class="act-icon" src="{{item.inBlack ? '/assets/history/unlike-on.png' : '/assets/history/unlike.png'}}" mode="aspectFit" />
      </view>
    </view>
  </view>
</template>

